+def classify_flakiness(isolated: list[str], file_run: str | None, test_file: str | None) -> FlakinessReport:
+    failures = isolated.count("failed")
+    runs = len(isolated)
+    if runs and failures == runs:
+        kind, summary = "deterministic", f"failed {failures}/{runs} isolated re-runs (deterministic)"
+    elif failures:
+        kind, summary = (
+            "intermittent",
+            (
+                f"INTERMITTENT: failed only {failures}/{runs} isolated re-runs; the failure is flaky "
+                "(timing, randomness, or shared state), so a fix must be shown to hold over repeated runs"
+            ),
+        )
+    elif file_run == "failed":
+        kind, summary = (
+            "order_dependent",
+            (
+                f"ORDER-DEPENDENT: passed {runs}/{runs} isolated re-runs but fails when `{test_file}` "
+                "runs as a whole; an earlier test in that file leaves state behind "
+                "(module-level state, caches, globals)"
+            ),
+        )
+    elif file_run == "passed":
+        kind, summary = (
+            "order_dependent",
+            (
+                f"ORDER-DEPENDENT: passes alone and when `{test_file}` runs alone, but fails in the "
+                "full suite; it depends on other test files or on shared external state"
+            ),
+        )
+    else:
+        kind, summary = "unknown", f"isolated re-runs: {isolated}; could not classify the failure"
+    return FlakinessReport(classification=kind, isolated_runs=isolated, file_run=file_run, summary=summary)
+
+
+def _status(run: ExecutionResult, test_name: str) -> str:
+    found = find_test(run.test_run, test_name) if run.test_run else None
+    return found.status if found else ("error" if run.infra_error else "missing")
+
