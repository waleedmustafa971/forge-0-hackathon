+def is_runtime_failure(result: ExecutionResult | None) -> bool:
+    """True when every failing test was failed by the runtime rather than by an assertion."""
+    failing = result.test_run.failing() if result and result.test_run else []
+    return bool(failing) and all(t.failure_type in RUNTIME_FAILURE_TYPES for t in failing)
