+    # ------------------------------------------------------------ iterative flow
+    def iterative_attempts(self) -> int:
+        """Baseline C gets as many model calls as FORGE-0's loop: hypotheses + experiment rounds + repairs."""
+        budget = self.ctx.budget if self.ctx else None
+        assert budget is not None
+        return 1 + budget.max_experiment_rounds + budget.max_repair_attempts
+
+    def _iterative(self, report: InvestigationReport) -> None:
+        ctx = self.ctx
+        assert ctx is not None and report.target_failure is not None
+        engineer = RepairEngineer(ctx)
+        verifier = IndependentVerifier(ctx)
+        previous: list[dict[str, Any]] = []
+        attempts = self.iterative_attempts()
+        for attempt in range(attempts):
+            draft = engineer.propose_iterative(report, previous, attempt)
+            verification = self._evaluate_patch(
+                draft, attempt, report.target_failure.test_name, engineer, verifier
+            )
+            if verification is None:
+                break  # the agent gave up (no edits)
+            if verification.verdict == "verified":
+                self._finish(
+                    "verified_fix",
+                    f"Baseline C's patch P{attempt + 1} passed the test suite after {attempt + 1} "
+                    f"edit-test iteration(s): {verification.reasons[0]}",
+                    report,
+                )
+                return
+            previous.append(
+                {
+                    "attempt": attempt + 1,
+                    "summary": draft.summary,
+                    "edits": [e.model_dump() for e in draft.edits],
+                    "test_results": verification.reasons,
+                    "regressions": verification.regressions,
+                    "target_after_patch": verification.target_patched,
+                }
+            )
+        self._finish(
+            "no_verified_fix",
+            f"Baseline C found no patch that passes the test suite in {len(previous) or 1} iteration(s).",
+            report,
+        )
+
