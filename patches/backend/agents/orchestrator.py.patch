+def _hypothesis_key(addressed: str | None) -> str | None:
+    """The hypothesis a patch addresses, as its key. Models sometimes add the title ("H1: Float-based
+    conversion..."), which does not fit the 16-character column and failed the insert on PostgreSQL."""
+    if not addressed:
+        return None
+    match = re.match(r"\s*(H\d+)(?!\d)", addressed)
+    return match.group(1) if match else addressed.strip()[:16]
