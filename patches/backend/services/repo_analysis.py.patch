+def resolve_python_import(root: Path, from_file: str, module: str) -> str | None:
+    """Maps `pkg.mod` (or a relative `.mod`) to a file in the repository, trying src/ layouts too."""
+    if module.startswith("."):
+        level = len(module) - len(module.lstrip("."))
+        base = PurePosixPath(from_file).parent
+        for _ in range(level - 1):
+            base = base.parent
+        rest = module.lstrip(".")
+        stems = [(base / rest.replace(".", "/")).as_posix() if rest else base.as_posix()]
+    else:
+        path = module.replace(".", "/")
+        stems = [path, f"src/{path}"]
+    for stem in stems:
+        for candidate in (f"{stem}.py", f"{stem}/__init__.py"):
+            if (root / candidate).is_file():
+                return posixpath.normpath(candidate)
+    return None
