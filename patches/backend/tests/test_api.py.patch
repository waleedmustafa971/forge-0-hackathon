+
+def test_latest_benchmark_is_the_newest_comparison_and_routed_runs_open(client, tmp_path, monkeypatch):
+    import json
+
+    from api.routes import system
+
+    results = tmp_path / "benchmarks" / "results"
+    results.mkdir(parents=True)
+    runs = {
+        "20261027-101729-meta": {"baseline": {}, "forge": {}},
+        "20261027-103750-meta+openai": {"forge": {}},  # newer, but a single-system smoke run
+    }
+    for run_id, aggregate in runs.items():
+        (results / f"{run_id}.json").write_text(json.dumps({"run_id": run_id, "aggregate": aggregate}))
+    monkeypatch.setattr(system, "REPO_ROOT", tmp_path)
+
+    assert client.get("/api/benchmarks/latest").json()["run_id"] == "20261027-101729-meta"
+    assert client.get("/api/benchmarks/20261027-103750-meta+openai").json()["run_id"].endswith("+openai")
+    assert client.get("/api/benchmarks/..%2Fsecrets").status_code in (400, 404)
