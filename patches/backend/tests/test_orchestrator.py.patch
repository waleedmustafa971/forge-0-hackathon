+        ("  H12 (leading)", "H12"),
+        ("the cache is never invalidated, so stale prices are served", "the cache is nev"),
+        (None, None),
+    ],
+)
+def test_patch_hypothesis_key_fits_its_column(addressed, key):
+    assert _hypothesis_key(addressed) == key
