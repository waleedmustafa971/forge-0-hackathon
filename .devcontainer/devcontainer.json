{
  // Try FORGE-0 in the browser: Code -> Codespaces -> Create codespace on main.
  // setup.sh assembles FORGE-0 (pre-hackathon core + this repository) and installs it;
  // start.sh serves the API and dashboard on port 8010 whenever the codespace starts.
  "name": "FORGE-0",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    // A daemon inside the codespace, so sandbox bind mounts see the same paths as FORGE-0.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8010],
  "portsAttributes": {
    "8010": { "label": "FORGE-0 dashboard", "onAutoForward": "openPreview" }
  },
  "secrets": {
    "META_API_KEY": {
      "description": "Optional. With a Meta Model API key, FORGE-0 runs on Muse Spark 1.3; without one, on its labelled mock provider.",
      "documentationUrl": "https://dev.meta.ai/docs"
    }
  }
}
