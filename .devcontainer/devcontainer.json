{
  // Try FORGE-0 in the browser: Code -> Codespaces -> Create codespace on main.
  // setup.sh assembles FORGE-0 (pre-hackathon core + this repository) and installs it;
  // start.sh serves the API and dashboard on port 8010 whenever the codespace starts.
  "name": "FORGE-0",
  "build": { "dockerfile": "Dockerfile" },  // the Python image, minus a broken apt source
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    // A Docker daemon inside the codespace, for FORGE-0's experiment sandbox.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  // Keep the creation log on screen until FORGE-0 answers, so nobody opens a half-installed copy.
  "waitFor": "postStartCommand",
  "forwardPorts": [8010],
  "portsAttributes": {
    "8010": { "label": "FORGE-0 dashboard", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "META_API_KEY": {
      "description": "Optional. With a Meta Model API key, FORGE-0 runs on Muse Spark 1.3; without one, on its labelled mock provider.",
      "documentationUrl": "https://dev.meta.ai/docs"
    }
  }
}
